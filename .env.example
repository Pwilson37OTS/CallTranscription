# OpenAI API key (required)
OPENAI_API_KEY=your-api-key-here

# Optional: override default models
# TRANSCRIPTION_MODEL=gpt-4o-transcribe
# SUMMARY_MODEL=gpt-4.1

# Optional: max upload size in MB (default: 500)
# MAX_UPLOAD_SIZE_MB=500

# Admin account (created on first run)
ADMIN_EMAIL=admin@oaktreestaffing.com
ADMIN_DEFAULT_PASSWORD=changeme123

# Optional: max API calls per user per hour (default: 50)
# RATE_LIMIT_PER_HOUR=50

# --- CloudCall Integration (optional) ---
# Set CLOUDCALL_REFRESH_TOKEN to enable the integration. Leave blank to disable.
# Get your refresh token from CloudCall Workspace > Company Settings > CloudCall API
# CLOUDCALL_REFRESH_TOKEN=your-refresh-token
# CLOUDCALL_API_BASE_URL=https://apio1.cloudcall.com
# CLOUDCALL_AUTH_URL=https://auth.cloudcall.com/connect/token
# CLOUDCALL_CLIENT_ID=o1-public-api
# CLOUDCALL_WEBHOOK_SIGNING_KEY=returned-when-you-create-webhook-subscription
# CLOUDCALL_RECORDING_RETENTION_HOURS=48
# CLOUDCALL_POLL_INTERVAL_MINUTES=5
# CLOUDCALL_POLL_START_HOUR_CT=6
# CLOUDCALL_POLL_END_HOUR_CT=18
